# ============================================================
# 成品库位智能推荐 —— 运行期配置模板
# 用法：复制本文件为 backend/.env，再填值。
# Settings 通过 WMS_ 前缀环境变量或 .env 覆盖（见 app/core/config.py）。
# .env 已被 .gitignore 忽略 —— 真实密钥只填 .env，不要提交本模板之外的密钥。
# ============================================================

# ---- 冷路径外部 LLM（09 原则④ · 默认打开、一键关闭）----

# 总开关：默认打开；关掉即核心链路零影响，也可运行时 POST /api/llm/toggle（仅管理员）切换。
WMS_COLD_PATH_ENABLED=true

# 供应商标识（大小写不敏感）：
#   ""                      = 不调用（仅规则卡片，不外发）
#   "mock"                  = 确定性回显（测试用，不外发）
#   "openai" / "openai_compatible" / "deepseek"
#                           = OpenAI 兼容 /chat/completions 接口
#                             （通吃 OpenAI / DeepSeek / 通义 / 月之暗面 / 智谱 / 本地 Ollama·vLLM）
WMS_LLM_PROVIDER=

# 你的 API Key（OpenAI 兼容 provider 必填；空 = 不发起调用，不带空 key 出站）。
WMS_LLM_API_KEY=

# 出站 base URL（末尾 /v1 可带可不带）。留空回落 OpenAI 官方 https://api.openai.com/v1
# 常见：
#   DeepSeek   https://api.deepseek.com/v1
#   通义        https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面    https://api.moonshot.cn/v1
#   智谱        https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama http://localhost:11434/v1
WMS_LLM_BASE_URL=

# 模型名。留空回落 gpt-4o-mini。
# 常见：deepseek-chat / qwen-plus / moonshot-v1-8k / glm-4
WMS_LLM_MODEL=

# ---- 成本护栏（默认已够用，一般不改）----
# 单请求超时（秒）。真实 OpenAI 兼容服务一次解读约 3~4s，默认 10s 已留余量。
WMS_LLM_REQUEST_TIMEOUT_S=10.0
WMS_LLM_MAX_TOKENS_PER_REQ=4096
WMS_LLM_MAX_CONCURRENCY=4
WMS_LLM_MONTHLY_BUDGET=1000000
